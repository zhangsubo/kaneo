# 通用 URL 配置
KANEO_CLIENT_URL=http://localhost:5174
# KANEO_API_URL=http://localhost:1337      # 宿主机原生启动 API 时需设置；一体化镜像会自动推导为 CLIENT_URL/api
# KANEO_INTERNAL_API_URL=http://127.0.0.1:1337 # 可选 - 仅用于内部 MCP 工具请求
# CORS_ORIGINS=                            # 可选 - 逗号分隔的跨域允许源列表；默认为 KANEO_CLIENT_URL

# 数据库配置
# DATABASE_URL=                            # 可选：宿主机原生运行或连接外部数据库时使用
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_PASSWORD=
# 或者挂载密钥文件并设置 POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# POSTGRES_HOST=postgres                   # Compose 容器默认主机名；宿主机原生启动 API 时请改为 localhost
# POSTGRES_PORT=5432
# 注意：仅设置 POSTGRES_DB 和 POSTGRES_USER 不会启用连接串自动推导模式。
# 只有设置了 POSTGRES_PASSWORD 或显式指定了 host/port 时，才会使用推导出的 DATABASE_URL。

# 用于 WebSockets 的 Redis Pub/Sub（可选）-> 未配置时自动降级为内存模式
# 只需配置其中一种模式。优先级：Cluster（集群） > Sentinel（哨兵） > Standalone（单机）。

# 单机模式（Standalone）
#REDIS_URL=

# 哨兵模式（Sentinel）
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# 集群模式（Cluster）
#REDIS_CLUSTER_NODES=

# 共享配置（Sentinel 与 Cluster 共用）
#REDIS_PASSWORD=

# 身份认证配置
# 生成命令：openssl rand -hex 32
# 宿主机原生启动时必填。若未设置，一体化镜像会生成一个临时密钥。
# 请保持该值稳定：它用于保护身份认证会话。
AUTH_SECRET=
# 或者挂载密钥文件并设置 AUTH_SECRET_FILE=/run/secrets/auth_secret

# GitHub 单点登录（使用 GitHub 登录，OAuth App）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 旧版 SSO 回退配置（仅在未设置 GITHUB_OAUTH_* 时生效）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub 集成（GitHub App：仓库同步、Webhooks）
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP 邮件服务配置
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
# 邮件内图片的可选公开基础 URL。默认为 KANEO_CLIENT_URL/email。
#KANEO_EMAIL_ASSETS_URL=
# 配置 SMTP 后，默认使用邮箱验证码登录。
# 设为 true 可改用邮箱/密码登录（邀请邮件仍会通过 SMTP 发送）。
#DISABLE_EMAIL_OTP_SIGN_IN=false

# 云端模式防滥用策略（仅在托管的多租户实例上开启）。
# 当 KANEO_CLOUD=true 时：禁止使用一次性邮箱服务商注册，
# 访客账号无法发送工作空间邀请，并启用更严格的速率限制。
# Turnstile 人机验证由 TURNSTILE_SECRET_KEY 独立控制。
#KANEO_CLOUD=false

# Cloudflare Turnstile（登录/注册人机验证 CAPTCHA）。设置密钥后强制验证；
# 留空则跳过验证（适用于自托管）。
#TURNSTILE_SECRET_KEY=
# Web 容器说明：生产镜像内置了 "KANEO_TURNSTILE_SITE_KEY" 占位符，
# 容器启动时由 apps/web/env.sh 读取此环境变量进行替换。
# 本地开发（vite）请在 apps/web/.env.local 中设置 VITE_TURNSTILE_SITE_KEY。
#KANEO_TURNSTILE_SITE_KEY=

# Sentry 错误追踪（可选）：仅在设置了 DSN 时上报错误
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1         # 0.0 表示禁用；默认为 0（需主动开启）
# SENTRY_PROFILES_SAMPLE_RATE=0.1      # 0.0 表示禁用；默认为 0（需主动开启）
# SENTRY_RELEASE=                       # Git SHA；用于将事件关联到 source maps。未设置时回退到 package.json 版本号。
# SENTRY_API_TOKEN=                     # 供 scripts/provision-sentry-alerts.sh 和 scripts/provision-sentry-dashboards.sh 使用。所需权限范围：org:write。https://sentry.io/settings/account/api/auth-tokens/

# 基于 Creem 的 Kaneo Cloud 计费配置（可选）：仅在 KANEO_CLOUD=true 且两个密钥均设置时生效。
# 自托管部署请保持为空；计费功能将保持关闭。
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=true                     # 使用 Creem 的沙盒（sandbox）API
# CREEM_PRODUCT_PERSONAL_MONTHLY=
# CREEM_PRODUCT_PERSONAL_ANNUAL=
# CREEM_PRODUCT_TEAM_MONTHLY=
# CREEM_PRODUCT_TEAM_ANNUAL=
# BILLING_TRIAL_DAYS=14
# BILLING_FOUNDING_CUTOFF=                 # ISO 日期；在此日期当天或之前创建的工作空间保留免费访问权限

# 私有文件上传：Silo 或其他兼容 S3 的存储服务商（可选）
# S3_ENDPOINT=https://files.example.com    # 需同时可被 API 服务端和浏览器访问
# S3_BUCKET=kaneo
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_MAX_IMAGE_UPLOAD_BYTES=10485760
# S3_PRESIGN_TTL_SECONDS=300
# S3_KEY_PREFIX=

# 访问控制策略（可选）
# DISABLE_REGISTRATION=false
# DISABLE_PASSWORD_REGISTRATION=false
# DISABLE_LOGIN_FORM=false
# DISABLE_GUEST_ACCESS=false
# DISABLE_WORKSPACE_CREATION=false
# DEVICE_AUTH_CLIENT_IDS=kaneo-cli,kaneo-mcp
# KANEO_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false

# 数据导入（可选）。来自 https://trello.com/power-ups/admin 的 Trello Power-Up API key，
# 用于引导工作空间管理员跳转至 Trello 授权导入。
# TRELLO_API_KEY=

# 保存个人通知令牌或签名密钥时必填。请保持该值稳定。
# NOTIFICATION_SECRET_ENCRYPTION_KEY=

# 企业自建应用单聊通知（可选）：配置后员工无需填写自定义 Webhook URL，即可通过邮箱/OpenID/手机号直接接收 1 对 1 机器人通知
# 飞书国内版（open.feishu.cn）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# Lark 国际版（open.larksuite.com）
# LARK_APP_ID=
# LARK_APP_SECRET=
# 钉钉企业内部应用机器人（api.dingtalk.com）
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_ROBOT_CODE=

